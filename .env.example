# PlugPort Server Configuration

# ---- General Configuration ----
# Indicates if the server is running on a testnet (affects API key generation)
IS_TESTNET=true

# Options: debug, info, warn, error
LOG_LEVEL=info

# Set to false to disable Prometheus /metrics endpoint
METRICS_ENABLED=true

# ---- Server Ports & Endpoints ----
HTTP_PORT=8080
HOST=0.0.0.0

# ---- Authentication & Security ----
# Set to enable API key auth on HTTP endpoints (leave blank to disable)
# API_KEY=your-secret-api-key

# Dashboard URL for CORS origin locking (required in production)
# In dev mode, all origins are allowed.
# DASHBOARD_URL=https://plugport.xyz

# Session encryption is derived from MONAD_PRIVATE_KEY (HMAC-SHA256).
# No separate JWT_SECRET is needed.

# Comma separated list of addresses allowed to bypass certain checks
# WHITELIST_ADDRESSES=0x...

# ---- Document Limits ----
# Maximum document size in bytes (default: 1MB)
MAX_DOC_SIZE=1048576

# Maximum execution time for SQL statements in milliseconds (default: 30000ms / 30s)
SQL_STATEMENT_TIMEOUT_MS=30000

# ---- Protocol Support ----
# Enable or disable various wire protocols
MONGODB_ENABLED=true
WIRE_PORT=27017

PG_ENABLED=false
PG_PORT=5432

MYSQL_ENABLED=false
MYSQL_PORT=3306

REDIS_ENABLED=false
REDIS_PORT=6379

# ---- Monad Testnet (Production Storage) ----
# Leave all blank to use in-memory storage (dev mode).
# Set all to connect to Monad via smart contract (production mode).


# Monad network URLs
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_WS_URL=wss://monad-testnet.drpc.org/ws
MONAD_CHAIN_ID=10143

# Gas station wallet private key (64 hex chars, no 0x prefix)
MONAD_PRIVATE_KEY=your_64_char_hex_private_key_here

# Deployed Smart Contracts
MONAD_CONTRACT_ADDRESS=0xYourDeployedContractAddress
# PRIVATE_STORE_CONTRACT=0x...
# MESSAGEBROKER_CONTRACT_ADDRESS=0x...
# MESSAGEBROKER_GAS_STATION=0x...
# RELATIONAL_CONTRACT_ADDRESS=0x...

# ---- On-Chain Authentication (PlugPortAuth) ----
# Address of the deployed PlugPortAuth contract
# AUTH_CONTRACT_ADDRESS=0xYourPlugPortAuthContractAddress

# Separate private key(s) for the gas station wallet(s) that sponsors auth meta-transactions and private store deployments.
# Support multiple wallets using a comma-separated list (e.g., "0xKey1,0xKey2") to enable round-robin load balancing.
# Use dedicated wallets, not your main MONAD_PRIVATE_KEY, for production isolation.
# AUTH_GAS_STATION_PRIVATE_KEYS=0xKey1,0xKey2
