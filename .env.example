# PlugPort Server Configuration

# ---- General Configuration ----
# Indicates if the server is running on a testnet (affects API key generation)
IS_TESTNET=true

# Options: debug, info, warn, error
LOG_LEVEL=info

# Set to false to disable Prometheus /metrics endpoint
METRICS_ENABLED=true

# ---- Server Ports & Endpoints ----
HTTP_PORT=8080
HOST=0.0.0.0

# ---- Authentication & Security ----
# Set to enable API key auth on HTTP endpoints (leave blank to disable)
# API_KEY=your-secret-api-key

# Comma separated list of addresses allowed to bypass certain checks
# WHITELIST_ADDRESSES=0x...

# ---- Document Limits ----
# Maximum document size in bytes (default: 1MB)
MAX_DOC_SIZE=1048576

# ---- Protocol Support ----
# Enable or disable various wire protocols
MONGODB_ENABLED=true
WIRE_PORT=27017

PG_ENABLED=false
PG_PORT=5432

MYSQL_ENABLED=false
MYSQL_PORT=3306

REDIS_ENABLED=false
REDIS_PORT=6379

# ---- Monad Testnet (Production Storage) ----
# Leave all blank to use in-memory storage (dev mode).
# Set all to connect to Monad via smart contract (production mode).


# Monad network URLs
MONAD_RPC_URL=https://monad-testnet.drpc.org
# MONAD_WS_URL=wss://monad-testnet.drpc.org/ws
MONAD_CHAIN_ID=10143

# Gas station wallet private key (64 hex chars, no 0x prefix)
MONAD_PRIVATE_KEY=your_64_char_hex_private_key_here

# Deployed Smart Contracts
MONAD_CONTRACT_ADDRESS=0xYourDeployedContractAddress
# PRIVATE_STORE_CONTRACT=0x...
# MESSAGEBROKER_CONTRACT_ADDRESS=0x...
# MESSAGEBROKER_GAS_STATION=0x...
# RELATIONAL_CONTRACT_ADDRESS=0x...
