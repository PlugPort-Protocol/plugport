# PlugPort — Monad Testnet Environment
# Copy to .env.testnet and fill in your values.

# ---- Monad Testnet Connection ----
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Gas station wallet private key (64 hex chars, no 0x prefix)
# Generate: npx tsx -e "import { generateKeypair } from './packages/server/src/storage/monaddb-adapter.js'; console.log(generateKeypair())"
MONAD_PRIVATE_KEY=your_64_char_hex_private_key_here

# Deployed PlugPortStore contract address
MONAD_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# ---- Dashboard & CORS ----
# Set to your dashboard URL for CORS origin locking
DASHBOARD_URL=http://localhost:3000

# ---- Authentication ----
# Set to enable API key auth on HTTP endpoints (leave blank to disable)
# API_KEY=your-secret-api-key

# ---- Protocol Toggles ----
MONGODB_ENABLED=true
PG_ENABLED=false
MYSQL_ENABLED=false
REDIS_ENABLED=true

# ---- Optional: Private Store (AES-256-GCM Encryption) ----
# Deploy PlugPortPrivateStore.sol and set the address
# PRIVATE_STORE_CONTRACT=0x...

# ---- Optional: Message Broker (On-Chain PubSub) ----
# MESSAGEBROKER_CONTRACT_ADDRESS=0x...
# MESSAGEBROKER_GAS_STATION=0x...
# MONAD_WS_URL=wss://monad-testnet.drpc.org/ws

# ---- Optional: Relational (JOIN Engine) ----
# RELATIONAL_CONTRACT_ADDRESS=0x...

# ---- Optional: On-Chain Authentication (PlugPortAuth) ----
# Deploy PlugPortAuth.sol and set the address for wallet-derived API key management.
# Also baked into the dashboard build (NEXT_PUBLIC_AUTH_CONTRACT_ADDRESS) so the
# browser can construct the correct EIP-712 domain for register/revoke/rotate signatures.
# AUTH_CONTRACT_ADDRESS=0xYourPlugPortAuthContractAddress
# Dedicated gas station wallets for sponsoring auth meta-transactions and private store deployments
# Support multiple wallets using a comma-separated list (e.g., "0xKey1,0xKey2") to enable round-robin load balancing.
# AUTH_GAS_STATION_PRIVATE_KEYS=your_64_char_hex_private_key_for_auth_gas_station
# ---- Monitoring ----
IS_TESTNET=true
LOG_LEVEL=info
METRICS_ENABLED=true
# GRAFANA_PASSWORD=your-grafana-password
