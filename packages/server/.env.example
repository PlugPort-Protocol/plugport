# PlugPort Server Configuration
# Copy to .env in the server package root

# ═══════════════════════════════════════════════════
# Core Settings
# ═══════════════════════════════════════════════════

# Indicates if the server is running on a testnet (affects API key generation)
IS_TESTNET=true

HTTP_PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
METRICS_ENABLED=true
MAX_DOC_SIZE=1048576

# API key auth (leave blank to disable)
# API_KEY=your-secret-api-key

# Dashboard URL for CORS origin locking (required in production)
# In dev mode, all origins are allowed.
# DASHBOARD_URL=https://plugport.xyz

# Session encryption is derived from MONAD_PRIVATE_KEY automatically (HMAC-SHA256).
# No separate JWT_SECRET is needed. Sessions are httpOnly cookies via iron-session.

# ═══════════════════════════════════════════════════
# Protocol Frontends
# Enable/disable individual database protocols.
# Each uses Monad as the storage backend.
# ═══════════════════════════════════════════════════

# MongoDB wire protocol (enabled by default)
MONGODB_ENABLED=true
WIRE_PORT=27017

# PostgreSQL wire protocol
PG_ENABLED=false
PG_PORT=5432

# MySQL wire protocol
MYSQL_ENABLED=false
MYSQL_PORT=3306

# Redis RESP protocol
REDIS_ENABLED=false
REDIS_PORT=6379

# ═══════════════════════════════════════════════════
# Monad Smart Contract (Production Storage)
# Leave blank to use in-memory storage (dev mode).
# Set all four for Monad-backed persistent storage.
# Writes cost MON gas. Reads are free.
# ═══════════════════════════════════════════════════

MONAD_RPC_URL=https://monad-testnet.drpc.org
MONAD_CHAIN_ID=10143

# Gas station wallet private key (64 hex chars, no 0x prefix)
# This wallet pays gas for all write operations.
MONAD_PRIVATE_KEY=

# Deployed PlugPortStore contract address
MONAD_CONTRACT_ADDRESS=

# ═══════════════════════════════════════════════════
# Private Store Capabilities
# Requires a separate contract to be deployed.
# ═══════════════════════════════════════════════════

# Deployed PlugPortPrivateStore contract address
# PRIVATE_STORE_CONTRACT=

# Comma-separated whitelisted Ethereum addresses
# WHITELIST_ADDRESSES=0xabc...,0xdef...

# ═══════════════════════════════════════════════════
# Message Broker (Redis Pub/Sub on-chain)
# Optional. Powers SUBSCRIBE/PUBLISH via PlugPortMessageBroker.sol.
# Uses a SEPARATE gas station from PlugPortStore.
# ═══════════════════════════════════════════════════

# Deployed PlugPortMessageBroker contract address
# MESSAGEBROKER_CONTRACT_ADDRESS=

# Monad WebSocket URL for real-time event subscriptions
# MONAD_WS_URL=wss://monad-testnet.drpc.org

# ═══════════════════════════════════════════════════
# Relational / JOIN Optimization (optional)
# Deployed PlugPortRelational.sol for batch reads.
# Reduces JOIN RPC round-trips from O(N) to O(1).
# ═══════════════════════════════════════════════════

# RELATIONAL_CONTRACT_ADDRESS=
