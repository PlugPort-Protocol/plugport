# PlugPort — Monad Mainnet Environment
# Copy to .env.mainnet and fill in your values.
#
# ⚠️  MAINNET: All writes cost real MON. Double-check contract addresses.

# ---- Monad Mainnet Connection ----
MONAD_RPC_URL=https://monad-mainnet.drpc.org
MONAD_CHAIN_ID=1

# Gas station wallet private key (64 hex chars, no 0x prefix)
# ⚠️  Use a DEDICATED gas wallet, not your personal wallet.
MONAD_PRIVATE_KEY=your_64_char_hex_private_key_here

# Deployed PlugPortStore contract address
MONAD_CONTRACT_ADDRESS=0xYourMainnetContractAddress

# ---- Dashboard & CORS ----
# Lock to your production domain (mandatory for mainnet)
DASHBOARD_URL=https://dashboard.plugport.xyz

# ---- Authentication ----
# Legacy API key (optional fallback; primary auth is now on-chain via PlugPortAuth)
# API_KEY=your-strong-api-key-here

# ---- Protocol Toggles ----
MONGODB_ENABLED=true
PG_ENABLED=false
MYSQL_ENABLED=false
REDIS_ENABLED=false

# ---- Private Store (AES-256-GCM Encryption) ----
# PRIVATE_STORE_CONTRACT=0x...

# ---- Message Broker (On-Chain PubSub) ----
# MESSAGEBROKER_CONTRACT_ADDRESS=0x...
# MESSAGEBROKER_GAS_STATION=0x...
# MONAD_WS_URL=wss://monad-mainnet.drpc.org/ws

# ---- Relational (JOIN Engine) ----
# RELATIONAL_CONTRACT_ADDRESS=0x...

# ---- On-Chain Authentication (PlugPortAuth) ----
# Deploy PlugPortAuth.sol and set the address for wallet-derived API key management.
# ⚠️  REQUIRED for production: wallet-derived keys replace the legacy API_KEY.
AUTH_CONTRACT_ADDRESS=0xYourPlugPortAuthMainnetAddress

# ⚠️  Use a DEDICATED wallet for the auth gas station (not your main MONAD_PRIVATE_KEY).
AUTH_GAS_STATION_PRIVATE_KEY=your_64_char_hex_private_key_for_auth_gas_station

# ---- Monitoring ----
IS_TESTNET=false
LOG_LEVEL=warn
METRICS_ENABLED=true
GRAFANA_PASSWORD=your-strong-grafana-password
