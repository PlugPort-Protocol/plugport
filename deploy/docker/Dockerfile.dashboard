# Multi-stage build for PlugPort Dashboard
FROM node:22-alpine AS builder

WORKDIR /app

# Native build toolchain (needed to compile native deps like bufferutil/utf-8-validate)
RUN apk add --no-cache python3 make g++

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/dashboard/package.json packages/dashboard/

RUN pnpm install --frozen-lockfile || pnpm install

COPY packages/shared/ packages/shared/
COPY packages/dashboard/ packages/dashboard/

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_AUTH_CONTRACT_ADDRESS
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_CHAIN_ID=${NEXT_PUBLIC_CHAIN_ID}
ENV NEXT_PUBLIC_AUTH_CONTRACT_ADDRESS=${NEXT_PUBLIC_AUTH_CONTRACT_ADDRESS}

RUN pnpm --filter @plugport/shared build
RUN pnpm --filter @plugport/dashboard build

# ---- Production ----
FROM node:22-alpine AS runner
WORKDIR /app

COPY --from=builder /app/packages/dashboard/.next/standalone ./
COPY --from=builder /app/packages/dashboard/.next/static ./packages/dashboard/.next/static
COPY --from=builder /app/packages/dashboard/public ./packages/dashboard/public

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

CMD ["node", "packages/dashboard/server.js"]
